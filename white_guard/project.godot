config_version=5

[application]
config/name="Белая гвардия — вступление"
config/version="0.3.0-intro"
config/use_custom_user_dir=true
config/custom_user_dir_name="WhiteGuardFoundation"
config/features=PackedStringArray("4.6", "GL Compatibility")
run/main_scene="res://scenes/intro.tscn"

[autoload]
SignalBus="*res://addons/arkon_runtime/core/signal_bus.gd"
GameState="*res://addons/arkon_runtime/core/game_state.gd"
PauseManager="*res://addons/arkon_runtime/core/pause_manager.gd"
SceneFlow="*res://addons/arkon_runtime/core/scene_flow.gd"
AudioManager="*res://addons/arkon_runtime/audio/audio_manager.gd"
GraphicsSettings="*res://addons/arkon_runtime/graphics/graphics_settings.gd"

[display/window]
size/viewport_width=1280
size/viewport_height=720
size/window_width_override=1280
size/window_height_override=720
stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.035, 0.045, 0.04, 1)

[arkon_runtime]
source_release="1.68"
source_commit="a1fd971558fcfe8d8fb99e944cc532edee5c32ba"
foundation_only=true
