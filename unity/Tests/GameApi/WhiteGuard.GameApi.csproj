<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>WhiteGuard.GameApi.CompileOnly</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Core/Arkon.Core.csproj" />
    <ProjectReference Include="../UnityApi/Arkon.UnityApi.csproj" />
    <Compile Include="../../WhiteGuard/Assets/Scripts/**/*.cs" />
    <Compile Include="../../WhiteGuard/Assets/Editor/**/*.cs" />
    <Reference Include="$(UnityReferenceRoot)/UnityEngine/*.dll" Private="false" />
  </ItemGroup>
  <Target Name="RequireUnityEngine" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(UnityReferenceRoot)/UnityEngine/UnityEngine.CoreModule.dll')" Text="Supply official Unity 6000.3.28f1 managed references. This only checks API compilation." />
  </Target>
</Project>
