+/* GFX1013 only: track ordinary fragment user-data writes in the primary IB. */
+enum {
+   RADV_PS_USER_DATA_COUNT = 32,
+   RADV_PS_USER_DATA_BASE = (R_00B030_SPI_SHADER_USER_DATA_PS_0 - SI_SH_REG_OFFSET) / 4,
+};
+
+struct radv_ps_sgpr_shadow {
+   const uint32_t *chunk;
+   unsigned cursor;
+   unsigned conditional_end;
+   uint32_t valid;
+   bool disabled;
+   uint32_t values[RADV_PS_USER_DATA_COUNT];
+};
+
+struct radv_ps_sgpr_cmd_buffer {
+   struct radv_cmd_buffer base;
+   struct radv_ps_sgpr_shadow shadow;
+};
+
+static bool
+radv_ps_sgpr_supported(const struct radv_physical_device *pdev,
+                      enum radv_queue_family queue, VkCommandBufferLevel level)
+{
+   return pdev->info.family == CHIP_GFX1013 && pdev->info.gfx_level == GFX10 &&
+          queue == RADV_QUEUE_GENERAL && level == VK_COMMAND_BUFFER_LEVEL_PRIMARY;
+}
+
+static struct radv_ps_sgpr_shadow *
+radv_ps_sgpr_shadow(const struct radv_physical_device *pdev, struct radv_cmd_buffer *cmd_buffer)
+{
+   if (!radv_ps_sgpr_supported(pdev, cmd_buffer->qf, cmd_buffer->vk.level))
+      return NULL;
+   return &((struct radv_ps_sgpr_cmd_buffer *)cmd_buffer)->shadow;
+}
+
+static void
+radv_ps_sgpr_disable(struct radv_cmd_buffer *cmd_buffer)
+{
+   const struct radv_physical_device *pdev = radv_device_physical(radv_cmd_buffer_device(cmd_buffer));
+   struct radv_ps_sgpr_shadow *shadow = radv_ps_sgpr_shadow(pdev, cmd_buffer);
+   if (shadow)
+      shadow->disabled = true;
+}
+
+static void
+radv_ps_sgpr_note_write(struct radv_ps_sgpr_shadow *shadow, unsigned first,
+                        unsigned count, const uint32_t *values)
+{
+   const unsigned begin = MAX2(first, RADV_PS_USER_DATA_BASE);
+   const unsigned end = MIN2(first + count, RADV_PS_USER_DATA_BASE + RADV_PS_USER_DATA_COUNT);
+   for (unsigned reg = begin; reg < end; reg++) {
+      unsigned index = reg - RADV_PS_USER_DATA_BASE;
+      if (values) {
+         shadow->values[index] = values[reg - first];
+         shadow->valid |= 1u << index;
+      } else {
+         shadow->valid &= ~(1u << index);
+      }
+   }
+}
+
+/* Return false at unsupported state changes or control flow. Do not try to
+ * recover a register model later in the command buffer after such a packet.
+ */
+static bool
+radv_ps_sgpr_read_packet(struct radv_ps_sgpr_shadow *shadow, const struct ac_cmdbuf *b,
+                         unsigned pos, unsigned size)
+{
+   const uint32_t *p = b->buf + pos;
+   switch (PKT3_IT_OPCODE_G(p[0])) {
+   case PKT3_SET_SH_REG:
+      if (size < 3 || p[1] >= SI_SH_REG_SPACE_SIZE / 4 || size - 2 > SI_SH_REG_SPACE_SIZE / 4 - p[1])
+         return false;
+      radv_ps_sgpr_note_write(shadow, p[1], size - 2,
+                            !(p[0] & 0xff) && pos >= shadow->conditional_end ? p + 2 : NULL);
+      return true;
+   case PKT3_SET_SH_REG_INDEX: {
+      unsigned reg = p[1] & 0x0fffffff;
+      if (size != 3 || (p[1] >> 28) != 3 || reg >= SI_SH_REG_SPACE_SIZE / 4)
+         return false;
+      radv_ps_sgpr_note_write(shadow, reg, 1, NULL);
+      return true;
+   }
+   case PKT3_COND_EXEC:
+      if (size != 5 || p[4] > b->max_dw - pos - size)
+         return false;
+      shadow->conditional_end = MAX2(shadow->conditional_end, pos + size + p[4]);
+      return true;
+   case PKT3_DRAW_INDIRECT:
+   case PKT3_DRAW_INDEX_INDIRECT:
+   case PKT3_DRAW_INDIRECT_MULTI:
+   case PKT3_DRAW_INDEX_INDIRECT_MULTI: {
+      const unsigned opcode = PKT3_IT_OPCODE_G(p[0]);
+      const bool multi = opcode == PKT3_DRAW_INDIRECT_MULTI || opcode == PKT3_DRAW_INDEX_INDIRECT_MULTI;
+      if (size != (multi ? 10 : 5) || p[2] >= SI_SH_REG_SPACE_SIZE / 4 || p[3] >= SI_SH_REG_SPACE_SIZE / 4)
+         return false;
+      radv_ps_sgpr_note_write(shadow, p[2], 1, NULL);
+      radv_ps_sgpr_note_write(shadow, p[3], 1, NULL);
+      if (multi && (p[4] & S_2C3_DRAW_INDEX_ENABLE(1))) {
+         unsigned reg = p[4] & 0xffff;
+         if (reg >= SI_SH_REG_SPACE_SIZE / 4)
+            return false;
+         radv_ps_sgpr_note_write(shadow, reg, 1, NULL);
+      }
+      return true;
+   }
+   case PKT3_SET_CONFIG_REG:
+      return size >= 3 && p[1] < (SI_CONFIG_REG_END - SI_CONFIG_REG_OFFSET) / 4 &&
+             size - 2 <= (SI_CONFIG_REG_END - SI_CONFIG_REG_OFFSET) / 4 - p[1];
+   case PKT3_SET_UCONFIG_REG:
+   case PKT3_SET_UCONFIG_REG_INDEX: {
+      const unsigned first = p[1] & 0xffff;
+      const unsigned grbm_index = (R_030800_GRBM_GFX_INDEX - CIK_UCONFIG_REG_OFFSET) / 4;
+      return size >= 3 && first < SI_UCONFIG_REG_SPACE_SIZE / 4 &&
+             size - 2 <= SI_UCONFIG_REG_SPACE_SIZE / 4 - first &&
+             (first > grbm_index || size - 2 <= grbm_index - first);
+   }
+   case PKT3_LOAD_CONTEXT_REG_INDEX:
+      return size == 5 && p[3] < SI_CONTEXT_REG_SPACE_SIZE / 4 && p[4] &&
+             p[4] <= SI_CONTEXT_REG_SPACE_SIZE / 4 - p[3];
+   case PKT3_SET_BASE:
+      return size == 4 && p[1] == 1;
+   case PKT3_DMA_DATA: {
+      if (size != 7)
+         return false;
+      unsigned dst = G_501_DST_SEL(p[1]);
+      return (dst == V_501_DST_ADDR && G_415_DAS(p[6]) == V_415_MEMORY) ||
+             dst == V_411_DST_ADDR_TC_L2 || dst == V_411_NOWHERE;
+   }
+   case PKT3_COPY_DATA: {
+      if (size != 6)
+         return false;
+      unsigned dst = (p[1] >> 8) & 0xf;
+      return dst == COPY_DATA_DST_MEM_GRBM || dst == COPY_DATA_TC_L2 || dst == COPY_DATA_DST_MEM;
+   }
+   case PKT3_WRITE_DATA: {
+      if (size < 5)
+         return false;
+      unsigned dst = G_370_DST_SEL(p[1]);
+      return dst == V_370_MEM_GRBM || dst == V_370_TC_L2 || dst == V_370_MEM;
+   }
+   case PKT3_NOP:
+   case PKT3_SET_CONTEXT_REG:
+   case PKT3_CONTEXT_REG_RMW:
+   case PKT3_DRAW_INDEX_2:
+   case PKT3_DRAW_INDEX_AUTO:
+   case PKT3_INDEX_BASE:
+   case PKT3_INDEX_BUFFER_SIZE:
+   case PKT3_NUM_INSTANCES:
+   case PKT3_EVENT_WRITE:
+   case PKT3_RELEASE_MEM:
+   case PKT3_ACQUIRE_MEM:
+   case PKT3_WAIT_REG_MEM:
+   case PKT3_PFP_SYNC_ME:
+   case PKT3_SET_PREDICATION:
+   case PKT3_PRIME_UTCL2:
+      return true;
+   default:
+      return false;
+   }
+}
+
+static bool
+radv_ps_sgpr_redundant(struct radv_ps_sgpr_shadow *shadow, const struct ac_cmdbuf *b,
+                      unsigned first, unsigned count, const uint32_t *values)
+{
+   if (shadow->disabled)
+      return false;
+   if (b->buf != shadow->chunk || b->cdw < shadow->cursor) {
+      shadow->chunk = b->buf;
+      shadow->cursor = 0;
+      shadow->conditional_end = 0;
+      shadow->valid = 0;
+   }
+   while (shadow->cursor < b->cdw) {
+      unsigned pos = shadow->cursor;
+      uint32_t header = b->buf[pos];
+      if (header == PKT2_NOP_PAD || header == PKT3_NOP_PAD) {
+         shadow->cursor++;
+         continue;
+      }
+      unsigned size = PKT_COUNT_G(header) + 2;
+      if (PKT_TYPE_G(header) != 3 || size > b->cdw - pos ||
+          !radv_ps_sgpr_read_packet(shadow, b, pos, size)) {
+         shadow->disabled = true;
+         return false;
+      }
+      shadow->cursor += size;
+   }
+   if (b->cdw < shadow->conditional_end)
+      return false;
+
+   unsigned index = first - RADV_PS_USER_DATA_BASE;
+   for (unsigned i = 0; i < count; i++) {
+      if (!(shadow->valid & (1u << (index + i))) || shadow->values[index + i] != values[i])
+         return false;
+   }
+   return true;
+}
