+/* GFX10 diagnostic only. The observer never modifies the command stream. */
+struct sgpr_observation {
+   const struct radv_cmd_buffer *owner;
+   const uint32_t *chunk;
+   unsigned cursor;
+   unsigned conditional_end;
+   bool opaque_flow;
+   bool bind_since_flush;
+   uint64_t started;
+   uint64_t binds, same_binds, flushes, emit_flushes;
+   uint64_t packets, known_packets, same_packets, words, same_words, same_dwords;
+   uint64_t bind_packets, bind_same_packets, indirect_packets, indirect_same_packets;
+   uint64_t clears, chunks, decode_errors;
+   uint64_t raw_matches, raw_bind_matches, conditional_packets;
+   uint32_t values[SI_SH_REG_SPACE_SIZE / 4];
+   uint32_t descriptor_values[SI_SH_REG_SPACE_SIZE / 4];
+   BITSET_DECLARE(known, SI_SH_REG_SPACE_SIZE / 4);
+   BITSET_DECLARE(descriptor_known, SI_SH_REG_SPACE_SIZE / 4);
+};
+
+static _Thread_local struct sgpr_observation sgpr_observations[8];
+
+static uint64_t
+sgpr_mono_ns(void)
+{
+   struct timespec ts;
+   clock_gettime(CLOCK_MONOTONIC, &ts);
+   return (uint64_t)ts.tv_sec * 1000000000 + ts.tv_nsec;
+}
+
+static struct sgpr_observation *
+sgpr_find_observation(const struct radv_cmd_buffer *cmd_buffer)
+{
+   for (unsigned i = 0; i < ARRAY_SIZE(sgpr_observations); i++)
+      if (sgpr_observations[i].owner == cmd_buffer)
+         return &sgpr_observations[i];
+   return NULL;
+}
+
+static void
+sgpr_begin_observation(const struct radv_cmd_buffer *cmd_buffer)
+{
+   if (!getenv("RADV_PS5_SGPR_LOG"))
+      return;
+   struct sgpr_observation *observation = sgpr_find_observation(cmd_buffer);
+   if (!observation)
+      observation = sgpr_find_observation(NULL);
+   if (!observation)
+      return;
+   memset(observation, 0, sizeof(*observation));
+   observation->owner = cmd_buffer;
+   observation->started = sgpr_mono_ns();
+}
+
+static void
+sgpr_end_observation(const struct radv_cmd_buffer *cmd_buffer)
+{
+   struct sgpr_observation *o = sgpr_find_observation(cmd_buffer);
+   if (!o)
+      return;
+   o->owner = NULL;
+   if (!o->binds && !o->flushes)
+      return;
+
+   const char *path = getenv("RADV_PS5_SGPR_LOG");
+   int fd = path ? open(path, O_WRONLY | O_APPEND | O_CLOEXEC | O_NOFOLLOW) : -1;
+   if (fd < 0)
+      return;
+   const uint64_t fields[] = {
+      sgpr_mono_ns(), o->started, cmd_buffer->vk.level, o->binds, o->same_binds,
+      o->flushes, o->emit_flushes, o->packets, o->known_packets, o->same_packets, o->words,
+      o->same_words, o->same_dwords, o->bind_packets, o->bind_same_packets,
+      o->indirect_packets, o->indirect_same_packets, o->clears, o->chunks, o->decode_errors,
+      o->raw_matches, o->raw_bind_matches, o->conditional_packets,
+   };
+   char line[512];
+   size_t n = strlen("sgpr-v3");
+   memcpy(line, "sgpr-v3", n);
+   for (unsigned i = 0; i < ARRAY_SIZE(fields); i++)
+      n += snprintf(line + n, sizeof(line) - n, " %" PRIu64, fields[i]);
+   line[n++] = '\n';
+   ssize_t written = write(fd, line, n);
+   (void)written;
+   close(fd);
+}
+
+static void
+sgpr_forget(struct sgpr_observation *o)
+{
+   BITSET_ZERO(o->known);
+   o->clears++;
+}
+
+static void
+sgpr_apply_packet(struct sgpr_observation *o, const uint32_t *packet,
+                  unsigned start, unsigned size, bool descriptor, bool indirect)
+{
+   unsigned opcode = PKT3_IT_OPCODE_G(packet[0]);
+   if (opcode == PKT3_COND_EXEC) {
+      if (size == 5 && packet[4] <= UINT_MAX - start - size) {
+         o->conditional_end = MAX2(o->conditional_end, start + size + packet[4]);
+         return;
+      }
+      o->opaque_flow = true;
+   } else if (opcode == PKT3_PRED_EXEC) {
+      o->opaque_flow = true;
+   }
+
+   switch (opcode) {
+   case PKT3_SET_SH_REG:
+      if (!(packet[0] & 0xfe) &&
+          size >= 3 && packet[1] < ARRAY_SIZE(o->values) && size - 2 <= ARRAY_SIZE(o->values) - packet[1]) {
+         bool conditional = o->opaque_flow || start < o->conditional_end || PKT3_PREDICATE(packet[0]);
+         if (descriptor) {
+            unsigned raw_same = 0;
+            for (unsigned i = 2; i < size; i++) {
+               unsigned reg = packet[1] + i - 2;
+               raw_same += BITSET_TEST(o->descriptor_known, reg) && o->descriptor_values[reg] == packet[i];
+               o->descriptor_values[reg] = packet[i];
+               BITSET_SET(o->descriptor_known, reg);
+            }
+            bool raw_match = raw_same == size - 2;
+            o->raw_matches += raw_match;
+            o->raw_bind_matches += raw_match && o->bind_since_flush;
+            o->conditional_packets += conditional;
+         }
+         if (conditional) {
+            for (unsigned i = 2; i < size; i++)
+               BITSET_CLEAR(o->known, packet[1] + i - 2);
+            return;
+         }
+         unsigned known = 0, same = 0;
+         for (unsigned i = 2; i < size; i++) {
+            unsigned reg = packet[1] + i - 2;
+            bool valid = BITSET_TEST(o->known, reg);
+            known += valid;
+            same += valid && o->values[reg] == packet[i];
+            o->values[reg] = packet[i];
+            BITSET_SET(o->known, reg);
+         }
+         if (descriptor) {
+            bool identical = same == size - 2;
+            o->known_packets += known == size - 2;
+            o->same_packets += identical;
+            o->same_words += same;
+            o->same_dwords += identical ? size : 0;
+            o->bind_same_packets += identical && o->bind_since_flush;
+            o->indirect_same_packets += identical && indirect;
+         }
+         return;
+      }
+      break;
+   /* Explicit register-space boundaries and packets with no SH-register destination. */
+   case PKT3_NOP:
+   case PKT3_SET_CONTEXT_REG:
+   case PKT3_SET_CONFIG_REG:
+   case PKT3_CONTEXT_REG_RMW:
+   case PKT3_DRAW_INDEX_2:
+   case PKT3_DRAW_INDEX_AUTO:
+   case PKT3_DRAW_INDEX_OFFSET_2:
+   case PKT3_INDEX_BASE:
+   case PKT3_INDEX_TYPE:
+   case PKT3_NUM_INSTANCES:
+   case PKT3_EVENT_WRITE:
+   case PKT3_RELEASE_MEM:
+   case PKT3_ACQUIRE_MEM:
+   case PKT3_WAIT_REG_MEM:
+   case PKT3_PFP_SYNC_ME:
+   case PKT3_SET_PREDICATION:
+   case PKT3_PRIME_UTCL2:
+   case PKT3_INDEX_BUFFER_SIZE:
+      return;
+   case PKT3_SET_BASE:
+      if (size == 4 && packet[1] == 1)
+         return;
+      break;
+   case PKT3_SET_SH_REG_INDEX: {
+      unsigned reg = packet[1] & 0x0fffffff;
+      if (size == 3 && (packet[1] >> 28) == 3 && reg < ARRAY_SIZE(o->values)) {
+         BITSET_CLEAR(o->known, reg);
+         return;
+      }
+      break;
+   }
+   case PKT3_DRAW_INDIRECT:
+   case PKT3_DRAW_INDEX_INDIRECT:
+   case PKT3_DRAW_INDIRECT_MULTI:
+   case PKT3_DRAW_INDEX_INDIRECT_MULTI: {
+      bool multi = opcode == PKT3_DRAW_INDIRECT_MULTI || opcode == PKT3_DRAW_INDEX_INDIRECT_MULTI;
+      if (size != (multi ? 10 : 5) || packet[2] >= ARRAY_SIZE(o->values) ||
+          packet[3] >= ARRAY_SIZE(o->values))
+         break;
+      if (multi && (packet[4] & S_2C3_DRAW_INDEX_ENABLE(1))) {
+         unsigned reg = packet[4] & 0xffff;
+         if (reg >= ARRAY_SIZE(o->values))
+            break;
+         BITSET_CLEAR(o->known, reg);
+      }
+      BITSET_CLEAR(o->known, packet[2]);
+      BITSET_CLEAR(o->known, packet[3]);
+      return;
+   }
+   case PKT3_DMA_DATA:
+      if (size == 7) {
+         unsigned dst = G_501_DST_SEL(packet[1]);
+         if ((dst == V_501_DST_ADDR && G_415_DAS(packet[6]) == V_415_MEMORY) ||
+             dst == V_411_DST_ADDR_TC_L2 || dst == V_411_NOWHERE)
+            return;
+      }
+      break;
+   case PKT3_COPY_DATA:
+      if (size == 6) {
+         unsigned dst = (packet[1] >> 8) & 0xf;
+         if (dst == COPY_DATA_DST_MEM_GRBM || dst == COPY_DATA_TC_L2 || dst == COPY_DATA_DST_MEM)
+            return;
+      }
+      break;
+   case PKT3_WRITE_DATA:
+      if (size >= 5) {
+         unsigned dst = G_370_DST_SEL(packet[1]);
+         if (dst == V_370_MEM_GRBM || dst == V_370_TC_L2 || dst == V_370_MEM)
+            return;
+      }
+      break;
+   case PKT3_SET_UCONFIG_REG:
+   case PKT3_SET_UCONFIG_REG_INDEX: {
+      const unsigned base = packet[1] & 0xffff;
+      const unsigned grbm_index = (R_030800_GRBM_GFX_INDEX - CIK_UCONFIG_REG_OFFSET) / 4;
+      if (base > grbm_index || size - 2 <= grbm_index - base)
+         return;
+      break;
+   }
+   }
+
+   /* In particular, forget state across nested IBs, indirect draws, and
+    * arbitrary register loads/writes. Disable comparisons after conditional execution. */
+   sgpr_forget(o);
+}
+
+static void
+sgpr_observe_packet(struct sgpr_observation *o, const struct ac_cmdbuf *b,
+                    unsigned start, bool indirect)
+{
+   if (!o)
+      return;
+   if (b->buf != o->chunk || start < o->cursor) {
+      o->chunk = b->buf;
+      o->cursor = 0;
+      o->conditional_end = 0;
+      o->chunks++;
+      sgpr_forget(o);
+   }
+
+   while (o->cursor < start) {
+      const uint32_t *packet = b->buf + o->cursor;
+      const unsigned type = PKT_TYPE_G(packet[0]);
+      unsigned size = 1;
+      if (type == 3 && packet[0] != PKT3_NOP_PAD) {
+         size = PKT_COUNT_G(packet[0]) + 2;
+         if (size > start - o->cursor) {
+            o->decode_errors++;
+            sgpr_forget(o);
+            break;
+         }
+         sgpr_apply_packet(o, packet, o->cursor, size, false, false);
+      } else if (type != 2 && type != 3) {
+         o->decode_errors++;
+         sgpr_forget(o);
+         break;
+      }
+      o->cursor += size;
+   }
+
+   unsigned size = b->cdw - start;
+   const uint32_t *packet = b->buf + start;
+   o->cursor = b->cdw;
+   if (size < 3 || PKT_TYPE_G(packet[0]) != 3 || PKT3_IT_OPCODE_G(packet[0]) != PKT3_SET_SH_REG ||
+       size != PKT_COUNT_G(packet[0]) + 2) {
+      o->decode_errors++;
+      sgpr_forget(o);
+      return;
+   }
+   o->packets++;
+   o->words += size - 2;
+   o->bind_packets += o->bind_since_flush;
+   o->indirect_packets += indirect;
+   sgpr_apply_packet(o, packet, start, size, true, indirect);
+}
